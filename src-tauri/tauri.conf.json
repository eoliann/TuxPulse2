{
  "productName": "TuxPulse",
  "version": "6.0.12",
  "identifier": "com.eoliann.tuxpulse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "TuxPulse",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/com.eoliann.tuxpulse.metainfo.xml": "../system_files/com.eoliann.tuxpulse.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/com.eoliann.tuxpulse.metainfo.xml": "../system_files/com.eoliann.tuxpulse.metainfo.xml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "TuxPulse System Toolkit",
    "longDescription": "Secure System Monitoring and Management Toolkit"
  }
}
